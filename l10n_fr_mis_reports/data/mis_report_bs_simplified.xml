<odoo>
    <record model="mis.report" id="mis_report_bs_simplified">
        <field name="name">Bilan (FR - liasse fiscale simplifiée)</field>
        <field
            name="description"
        >Si vous avez besoin de personnaliser ce modèle de rapport MIS, dupliquez-le et modifiez la version dupliquée.</field>
        <field name="constraint_type">balance_sheet</field>
    </record>

    <!-- ACTIF -->
    <record model="mis.report.kpi" id="mis_report_bs_simplified_csna">
        <!-- This KPI is not on the simplified liasse fiscale, but it is on the ANC simplified BS -->
        <field name="report_id" ref="mis_report_bs_simplified" />
        <field name="name">csna</field>
        <field name="description">Capital souscrit non appelé</field>
        <field name="expression">bale[109%]</field>
        <field name="type">num</field>
        <field name="compare_method">pct</field>
        <field name="auto_expand_accounts" eval="True" />
        <field name="auto_expand_accounts_style_id" ref="account_detail" />
        <field name="sequence">5</field>
    </record>
