"The SIREN '{siren}' of partner '{partner_name}' is incorrect: it must have "
"exactly 9 digits."
msgstr ""

#. module: l10n_fr_siret
#. odoo-python
#: code:addons/l10n_fr_siret/models/res_partner.py:0
#, python-format
