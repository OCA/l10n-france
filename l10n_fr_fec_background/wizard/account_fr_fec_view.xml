<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_fr_fec_view_inherit" model="ir.ui.view">
        <field name="name">l10n_fr.fec.export.wizard.view.inherit</field>
        <field name="model">account.fr.fec.oca</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="l10n_fr_fec_oca.account_fr_fec_oca_form" />
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@name='generate_fec']" position="after">
                <button
                    string="TXT"
                    name="generate_fec_txt"
                    type="object"
                    class="oe_highlight"
                />
                <button
                    string="CSV Background"
                    name="generate_fec_background"
                    type="object"
                    class="oe_highlight"
                />
                <button
                    string="TXT Background"
                    name="generate_fec_txt_background"
                    type="object"
                    class="oe_highlight"
                />
            </xpath>
            <xpath expr="//footer/button[@name='generate_fec']" position="attributes">
                <attribute name="string">CSV</attribute>
            </xpath>
        </field>
    </record>
</odoo>
