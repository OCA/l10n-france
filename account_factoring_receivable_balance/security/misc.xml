<odoo>

    <record id="base.user_admin" model="res.users">
        <field
            name="groups_id"
            eval="[(4, ref('account.group_account_user'), False), (4, ref('base.group_multi_currency'), False)]"
        />
    </record>

    <record id="subrogation_receipt_comp_rule" model="ir.rule">
        <field name="name">Subrogation Receipt multi-company</field>
        <field name="model_id" ref="model_subrogation_receipt" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_multi_company'))]" />
    </record>

</odoo>
