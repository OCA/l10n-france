<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Taxes of the French margin scheme, as templates attached to the French
         chart. Odoo generates one tax per company loading that chart; the
         previous records hardcoded base.main_company and therefore existed for
         a single company whatever the database held.

         The rate is VAT-inclusive (price_include): the margin is a gross
         amount and the tax is extracted from it. -->

    <!-- TVA sur marge 5,5% TTC -->
    <record id="tax_template_margin_5_5_sale" model="account.tax.template">
        <field name="chart_template_id" ref="l10n_fr.l10n_fr_pcg_chart_template"/>
        <field name="name">TVA sur marge 5,5% TTC - Vente</field>
        <field name="amount_type">margin_percentage</field>
        <field name="amount">5.5</field>
        <field name="vat_on_margin">True</field>
        <field name="type_tax_use">sale</field>
        <field name="price_include">True</field>
        <field name="active">True</field>
        <field name="tax_calculation_method">margin</field>
        <field name="tax_scope">service</field>
        <field name="tax_group_id" ref="l10n_fr_vat_on_margin.tax_group_margin_vat"/>
        <field name="description">TVA sur marge 5,5% TTC</field>
        <!-- Spelled out because _get_tax_vals_complete() always writes the
             distribution: a template that declares none yields a tax with no
             base line, which the account.tax constraint rejects. These lines
             reproduce Odoo's own default_get exactly. -->
        <field name="invoice_repartition_line_ids" eval="[(5, 0, 0),
            (0, 0, {'repartition_type': 'base', 'factor_percent': 100}),
            (0, 0, {'repartition_type': 'tax', 'factor_percent': 100})]"/>
        <field name="refund_repartition_line_ids" eval="[(5, 0, 0),
            (0, 0, {'repartition_type': 'base', 'factor_percent': 100}),
            (0, 0, {'repartition_type': 'tax', 'factor_percent': 100})]"/>
    </record>

