        <field name="amount">5.5</field>
        <field name="vat_on_margin">True</field>
        <field name="type_tax_use">purchase</field>
        <field name="price_include">True</field>
        <field name="active">True</field>
        <field name="tax_calculation_method">margin</field>
        <field name="tax_scope">service</field>
        <field name="tax_group_id" ref="l10n_fr_vat_on_margin.tax_group_margin_vat"/>
        <field name="description">TVA sur marge 5,5% TTC</field>
        <field name="invoice_repartition_line_ids" eval="[(5, 0, 0),
            (0, 0, {'repartition_type': 'base', 'factor_percent': 100}),
