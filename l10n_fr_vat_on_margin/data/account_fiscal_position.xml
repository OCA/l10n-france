    <!-- ⚠ THIS FILE IS NOT LOADED: it is commented out in __manifest__.py, and
         it cannot be loaded as it stands. Three problems, none of which shows
         until someone uncomments the line:

         1. Every ref() below points at an xmlid that no longer exists. The
            accounts and taxes became templates generated per company
            (account_template_604500, tax_template_margin_20_purchase, ...),
            so this file would have to become account.fiscal.position.template
            records mapping template to template.
         2. Three of the four account mappings are commented out, so the
            706500/707500/607500 accounts this module creates would still
            never receive anything. Only purchases of services would be
            rerouted.
         3. The record lost the `note` field that carried the mention French
            law requires on a margin scheme invoice (art. 242 nonies A CGI).
            i18n/fr.po still holds the orphan entry for it:
            "<strong>TVA sur marge</strong> - Régime particulier de
            taxation<br>", untranslated.

         Wiring this up is a fiscal decision, not a mechanical fix. -->

    <!--! Position fiscale pour le module TVA sur marge -->
    <record id="fiscal_position_margin" model="account.fiscal.position">
        <field name="name">TVA sur marge</field>
        <field name="vat_on_margin">True</field>
    </record>

    <!-- Règles de mappage pour la position fiscale des achats -->
    <record id="account_map_604000_to_604500" model="account.fiscal.position.account">
        <field name="position_id" ref="fiscal_position_margin"/>
        <field name="account_src_id" ref="l10n_fr.pcg_604"/>
        <field name="account_dest_id" ref="account_604500"/>
    </record>

