<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="default_taxes_setting_container" position="after">
                <block title="France VAT" id="fr_vat_block">
                    <field name="fr_vat_company_partner_id" invisible="1" />
                    <setting id="fr_vat_exigibility">
                        <field name="fr_vat_exigibility" />
                        <button
                            type="action"
                            name="%(l10n_fr_vat_exigibility_update_action)d"
                            string="Change VAT Exigibility"
                            context="{'default_company_id': company_id}"
                            class="oe_link"
                            icon="fa-exchange"
                        />
                    </setting>
                    <setting id="fr_vat_periodicity">
                        <field name="fr_vat_periodicity" />
                    </setting>
                    <setting id="fr_vat_bank_account_id">
                        <field name="fr_vat_bank_account_id" />
                    </setting>
                    <setting id="fr_vat_journal_id">
                        <field name="fr_vat_journal_id" />
                    </setting>
                    <setting id="l10n_fr_rounding_difference_loss_account_id">
                        <field name="l10n_fr_rounding_difference_loss_account_id" />
                    </setting>
                    <setting id="l10n_fr_rounding_difference_profit_account_id">
                        <field name="l10n_fr_rounding_difference_profit_account_id" />
                    </setting>
                    <setting
                        id="fr_vat_expense_analytic_distribution"
                        groups="analytic.group_analytic_accounting"
                    >
                        <field
                            name="fr_vat_expense_analytic_distribution"
                            widget="analytic_distribution"
                            options="{'business_domain': 'general'}"
                        />
                    </setting>
                    <setting
                        id="fr_vat_income_analytic_distribution"
                        groups="analytic.group_analytic_accounting"
                    >
                        <field
                            name="fr_vat_income_analytic_distribution"
                            widget="analytic_distribution"
                            options="{'business_domain': 'general'}"
                        />
                    </setting>

                    <setting
                        id="fr_vat_send_gateway"
                        invisible="fr_vat_periodicity not in ('1', '3')"
                    >
                        <field name="fr_vat_send_gateway" />
                    </setting>
                    <setting
                        id="fr_vat_remind_user_ids"
                        invisible="fr_vat_periodicity not in ('1', '3')"
                        string="Default VAT Gateway"
                    >
                        <field
                            name="fr_vat_remind_user_ids"
                            widget="many2many_tags"
                            string="Users to Remind"
                        />
                    </setting>
                    <setting
                        id="fr_vat_remind_deadline_day"
                        invisible="fr_vat_periodicity not in ('1', '3')"
                    >
                        <field
                            name="fr_vat_remind_deadline_day"
                            string="Deadline Day"
                        />
                    </setting>
                    <setting
                        id="fr_vat_remind_auto_generate_and_transmit"
                        invisible="fr_vat_periodicity not in ('1', '3')"
                    >
                        <field name="fr_vat_remind_auto_generate_and_transmit" />
                    </setting>
                    <setting
                        id="fr_vat_manual_autoliq_line_default_option"
                        help="This is the default option for unreconciled VAT autoliquidation journal items for which Odoo cannot compute the option automatically (usually correspond to journal items that are not in the purchase journal). This option is required only when the option 'Auto-generate and Transmit on Deadline Day' is enabled."
                    >
                        <field
                            name="fr_vat_manual_autoliq_line_default_option"
                            required="fr_vat_remind_auto_generate_and_transmit"
                        />
                    </setting>
                    <setting id="fr_vat_update_lock_dates">
                        <field name="fr_vat_update_lock_dates" />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
