<odoo>
    <record id="hr_contract_view_search" model="ir.ui.view">
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_search" />
        <field name="arch" type="xml">
            <filter name="group_by_job" position="after">
                <filter
                    name="group_work_location_id"
                    string="Localisation du Bureau"
                    context="{'group_by': 'work_location_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <group name="notes_group" position="before">
                <group name="rup">
                    <field name="pcs_id" />
                    <field name="employer_address_id" />
                    <field name="qualification" />
                    <field name="work_location_id" />
                </group>
            </group>
        </field>
    </record>
</odoo>
