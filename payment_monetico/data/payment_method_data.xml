<odoo>
    <record id="payment_method_cb" model="payment.method">
        <field name="name">CB</field>
        <field name="code">cb</field>
        <field
            name="primary_payment_method_id"
            eval="ref('payment.payment_method_card')"
        />
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_monetico/static/img/cb.png" />
    </record>
</odoo>
