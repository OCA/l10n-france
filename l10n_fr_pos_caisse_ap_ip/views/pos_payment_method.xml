<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
        <field name="arch" type="xml">
            <field name="payment_provider" position="after">
                <field
                    name="fr_caisse_ap_ip_address"
                    invisible="payment_provider != 'fr-caisse_ap_ip'"
                    required="payment_provider == 'fr-caisse_ap_ip'"
                />
                <field
                    name="fr_caisse_ap_ip_port"
                    invisible="payment_provider != 'fr-caisse_ap_ip'"
                    required="payment_provider == 'fr-caisse_ap_ip'"
                />
                <field
                    name="fr_caisse_ap_ip_mode"
                    invisible="payment_provider != 'fr-caisse_ap_ip'"
                    required="payment_provider == 'fr-caisse_ap_ip'"
                />
            </field>
        </field>
    </record>
</odoo>
