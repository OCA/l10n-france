<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_inherit_inpi" model="ir.ui.view">
        <field name="name">res.company.form.inherit.inpi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Configuration INPI" name="inpi_config">
                    <group>
                        <group string="Identifiants API">
                            <div class="o_group">
                                <group>
                                    <field name="inpi_user" />
                                    <field name="inpi_pass" password="True" />
                                </group>
                                <group>
                                    <field name="inpi_url" />
                                    <field name="inpi_timeout" />
                                </group>
                            </div>
                        </group>
                    </group>

                    <group string="Mapping des Champs">
                        <div class="mb-2">
                            <button
                                name="action_init_inpi_mapping"
                                string="Initialiser les champs par défaut"
                                type="object"
                                class="btn-secondary"
                                icon="fa-magic"
                                help="Crée automatiquement les correspondances pour le nom, l'adresse et le SIREN."
                            />
                        </div>
                        <field name="inpi_mapping_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="api_key" />
                                <field name="partner_field_id" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
