<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="fr_inpi_lookup_partner_action" model="ir.actions.act_window">
        <field name="name">SIREN Lookup via INPI</field>
        <field name="res_model">fr.inpi.lookup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_partner_manager'))]" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">form</field>
    </record>

    <record id="view_api_inpi_mapping_tree" model="ir.ui.view">
        <field name="name">api.inpi.mapping.tree</field>
        <field name="model">api.inpi.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="api_key" />
                <field name="partner_field_id" options="{'no_create': True}" />
            </list>
        </field>
    </record>
</odoo>
