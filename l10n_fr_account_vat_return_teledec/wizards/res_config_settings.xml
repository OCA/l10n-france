<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="l10n_fr_account_vat_return.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <block id="fr_vat_block" position="inside">
                <setting
                    id="fr_vat_teledec_email"
                    invisible="fr_vat_periodicity not in ('1', '3')"
                    help="Parameter required for the teletransmission of CA3"
                >
                    <field name="fr_vat_teledec_email" />
                </setting>
                <setting
                    id="fr_vat_teledec_legal_representative"
                    invisible="fr_vat_periodicity not in ('1', '3')"
                    help="Parameter required for the teletransmission of CA3"
                >
                    <field name="fr_vat_teledec_legal_representative_id" />
                </setting>
                <setting
                    id="fr_vat_teledec_legal_form"
                    invisible="fr_vat_periodicity not in ('1', '3')"
                    help="Parameter required for the teletransmission of CA3"
                >
                    <field name="fr_vat_teledec_legal_form" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
